---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — WORKBENCH SHELF archetype.
 *
 * Not a centered top-nav magazine bar. A stamped tool-cabinet LABEL PLATE:
 * a thick pine spine down the left edge, the brand set as a machined plate
 * with a drilled mounting hole, and nav rendered as engraved drawer tabs
 * along the plate's runner — the way a maker labels the front of a cabinet.
 *
 *   ┃  THE BENCH  hobbies-blog.oriz.in            [Shelf] [Series] [Tags]
 *   ┃  ·──────────────── engraved runner ─────────────── [About]  ⌘K  ···
 *
 * The pine spine is the family-independent structural signature. Sticky, but
 * reads as a hardware plate, not a blurred magazine bar.
 */
import Wordmark from '~/components/Wordmark.astro'
---

<StatusBanner />
<header class="bench-plate" transition:persist="site-header">
  <div class="plate-inner">
    <div class="plate-brand">
      <span class="plate-bolt" aria-hidden="true"></span>
      <a class="plate-mark" href="/" aria-label="The Bench — home">
        <span class="plate-name">The Bench</span>
        <span class="plate-addr">hobbies-blog.oriz.in</span>
      </a>
      <span class="plate-wm" aria-hidden="true">
        <Wordmark subtitle="hobbies" size={15} href={null} />
      </span>
    </div>

    <nav class="drawer-tabs" aria-label="Primary">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Shelf</a>
      <a href="/series/" aria-current={Astro.url.pathname.startsWith('/series') ? 'page' : undefined}>Series</a>
      <a href="/tags/" aria-current={Astro.url.pathname.startsWith('/tags') ? 'page' : undefined}>Tags</a>
      <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
    </nav>

    <div class="plate-tools">
      <div class="plate-search"><MultiSearch client:idle /></div>
      <div class="plate-controls"><HeaderControls client:idle /></div>
    </div>
  </div>
  <div class="plate-runner" aria-hidden="true"></div>
</header>

<style>
  .bench-plate {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bench-2);
    border-bottom: 1px solid var(--rule-strong);
    /* thick pine spine down the left edge — the plate's mounting rail */
    border-left: 6px solid var(--pine);
  }
  .plate-inner {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    min-height: 60px;
    padding-inline: clamp(0.9rem, 3vw, 1.75rem);
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    flex-wrap: wrap;
  }

  /* ── brand plate ─────────────────────────────────────────────────── */
  .plate-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 0 0 auto;
    position: relative;
  }
  .plate-bolt {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bench);
    border: 1.5px solid var(--rule-strong);
    box-shadow: inset 0 0 0 1px var(--bench-2);
    flex: 0 0 auto;
  }
  .plate-mark {
    display: inline-grid;
    text-decoration: none;
    line-height: 1;
  }
  .plate-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .plate-addr {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-top: 3px;
  }
  .plate-mark:hover .plate-name { color: var(--copper); }
  .plate-wm { display: none; }
  @media (min-width: 1024px) {
    .plate-wm {
      display: inline-flex;
      align-items: center;
      padding-left: 0.75rem;
      margin-left: 0.25rem;
      border-left: 1px solid var(--rule);
    }
  }

  /* ── drawer-tab nav — engraved runner, not centered pills ────────── */
  .drawer-tabs {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-left: auto;
    order: 3;
    width: 100%;
    border-top: 1px solid var(--rule);
    margin-top: 0.5rem;
    padding-top: 0.4rem;
  }
  .drawer-tabs a {
    position: relative;
    padding: 0.5rem 0.85rem;
    color: var(--ink-mute);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .drawer-tabs a:first-child { padding-left: 0; }
  .drawer-tabs a:hover { color: var(--ink); }
  .drawer-tabs a:hover,
  .drawer-tabs a[aria-current='page'] { border-bottom-color: var(--copper); }
  .drawer-tabs a[aria-current='page'] { color: var(--pine); font-weight: 700; }

  /* ── tools cluster (search + controls) ───────────────────────────── */
  .plate-tools {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
    order: 2;
  }
  .plate-search,
  .plate-controls { display: inline-flex; align-items: center; }

  /* runner groove hairline under the whole plate */
  .plate-runner {
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--rule) 0 6px,
      transparent 6px 12px
    );
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .plate-inner { flex-wrap: nowrap; min-height: 66px; }
    .drawer-tabs {
      order: 0;
      width: auto;
      border-top: 0;
      margin-top: 0;
      padding-top: 0;
      margin-left: clamp(1rem, 4vw, 3rem);
    }
    .drawer-tabs a:first-child { padding-left: 0.85rem; }
    .plate-tools { order: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-tabs a { transition: none; }
    .plate-mark:hover .plate-name { transition: none; }
  }
</style>
