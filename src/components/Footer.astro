---
/*
 * blog-app Footer — "Signal Press" editorial surface.
 *
 * Signature element: a serif pull-quote (Source Serif 4) with a signal-orange
 * quote mark — the only place the footer raises its voice. Everything else
 * stays library-quiet: mono column headings, mono tag links, hairline rules.
 *
 * Reads palette + type from the editorial tokens (tokens.css / global.css).
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const categories = [
  { name: 'All categories', slug: '' },
  ...(await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
    name: category,
    slug: slugifyTag(category),
  })),
]
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="bench-footer" role="contentinfo">
  <div class="bf-runner" aria-hidden="true"></div>
  <div class="bf-inner">
    <div class="bf-stamp">
      <blockquote class="bf-quote">
        <span aria-hidden="true" class="bf-q-mark">“</span>Buy once. Buy the right thing.
      </blockquote>
      <p class="bf-quote-attr">— The Bench · hobbies</p>
    </div>
    <div class="bf-drawers">
      <section class="bf-drawer">
        <h3 class="bf-h">Shelves</h3>
        <ul>
          {categories.map((c) => <li><a href={c.slug ? `/categories/${c.slug}/` : '/categories/'}>{c.name}</a></li>)}
        </ul>
      </section>
      <section class="bf-drawer">
        <h3 class="bf-h">On the rack</h3>
        <ul>
          <li><a href="/blog/">Latest posts</a></li>
          <li><a href="/series/">Series</a></li>
          <li><a href="/archive/">Archive</a></li>
          <li><a href="/now/">Now</a></li>
        </ul>
      </section>
      <section class="bf-drawer">
        <h3 class="bf-h">Tags</h3>
        <ul class="bf-tags">
          {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
        </ul>
      </section>
    </div>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-hobbies"
    appName="The Bench"
    bio="Honest starter guides and gear notes for film, keyboards, woodworking, and more — by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .bench-footer {
    margin-top: 5rem;
    background: var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 3px solid var(--pine);
  }
  /* drawer-runner groove strip along the top edge */
  .bf-runner {
    height: 6px;
    background: repeating-linear-gradient(90deg, var(--rule) 0 10px, transparent 10px 20px);
    opacity: 0.6;
  }
  .bf-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 28px;
    padding: 40px 16px 24px;
  }
  .bf-stamp { max-width: 560px; }
  .bf-quote {
    margin: 0;
    font-family: var(--font-display, 'Fraunces', Georgia, serif);
    font-style: normal; font-weight: 600; font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.3; letter-spacing: -0.015em;
    color: var(--color-ink, var(--ink));
  }
  .bf-q-mark { font-size: 1.5em; line-height: 0; color: var(--copper, var(--color-accent)); margin-right: 4px; }
  .bf-quote-attr {
    margin: 16px 0 0; font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-ink-mute, var(--ink-mute));
  }
  .bf-drawers { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .bf-h {
    margin: 0 0 12px;
    font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--color-ink-mute, var(--ink-mute)); font-weight: 700;
    padding-left: 10px; border-left: 3px solid var(--copper);
  }
  .bf-drawer ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .bf-drawer a { color: var(--color-ink, var(--ink)); font-size: 14px; text-decoration: none; }
  .bf-drawer a:hover { color: var(--pine); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bf-tags { flex-direction: row; flex-wrap: wrap; gap: 8px 12px; }
  .bf-tags a { font-family: var(--font-mono, ui-monospace); font-size: 13px; color: var(--color-ink-mute, var(--ink-mute)); }
  .bf-tags a:hover { color: var(--copper); text-decoration: none; }
  @media (min-width: 768px) {
    .bf-inner { grid-template-columns: 1fr 1.4fr; gap: 40px; padding: 56px 24px 28px; align-items: start; }
    .bf-drawers { grid-template-columns: repeat(3, 1fr); }
  }
</style>
