---
/**
 * WorkshopRating — signature module for The Bench (hobbies-blog.oriz.in).
 *
 * Renders a 5-peg workshop board showing three hobby dimensions:
 *   Cost (wallet depth needed), Skill (entry curve), Time (weekly hours).
 *
 * Each peg is a drilled hole on the board: filled = met, hollow = not yet.
 * Entirely CSS — no JS. Reduced-motion safe (no animation on prefers-reduce).
 *
 * Usage:
 *   <WorkshopRating cost={3} skill={2} time={4} />
 *   cost/skill/time: 1–5 integer (or undefined = omit row)
 */

export interface Props {
  cost?: number
  skill?: number
  time?: number
  compact?: boolean
}

const { cost, skill, time, compact = false } = Astro.props

const MAX = 5

function pegs(value: number | undefined, label: string, icon: string) {
  if (value === undefined) return null
  const v = Math.max(1, Math.min(MAX, Math.round(value)))
  return { label, icon, v }
}

const rows = [
  pegs(cost, 'Cost', '$'),
  pegs(skill, 'Skill', '✦'),
  pegs(time, 'Time', '⏱'),
].filter(Boolean) as { label: string; icon: string; v: number }[]
---

{rows.length > 0 && (
  <div class:list={['workshop-rating', compact && 'workshop-rating--compact']} role="group" aria-label="Workshop rating">
    <span class="wr-label mono">Workshop rating</span>
    <div class="wr-board">
      {rows.map(({ label, icon, v }) => (
        <div class="wr-row">
          <span class="wr-dim mono" aria-hidden="true">{icon}</span>
          <span class="wr-dim-label">{label}</span>
          <span class="wr-pegs" role="img" aria-label={`${label}: ${v} of ${MAX}`}>
            {Array.from({ length: MAX }, (_, i) => (
              <span class:list={['wr-peg', i < v && 'wr-peg--filled']} aria-hidden="true" />
            ))}
          </span>
          <span class="wr-val mono">{v}/{MAX}</span>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .workshop-rating {
    display: inline-grid;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    background: var(--bench-2, #f7f1e5);
    border: 1px solid var(--rule, #d3c8b2);
    border-top: 3px solid var(--pine, #2f5b3f);
    border-radius: var(--radius-card, 4px);
    min-width: 180px;
  }
  .workshop-rating--compact {
    padding: 0.5rem 0.75rem;
    gap: 0.25rem;
  }
  .wr-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute, #6c6455);
    margin-bottom: 0.15rem;
  }
  .wr-board { display: grid; gap: 0.3rem; }
  .wr-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wr-dim {
    font-size: 11px;
    width: 14px;
    text-align: center;
    color: var(--copper, #a4471a);
    flex: 0 0 auto;
  }
  .wr-dim-label {
    font-family: var(--font-mono, ui-monospace);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute, #6c6455);
    width: 34px;
    flex: 0 0 auto;
  }
  .wr-pegs {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .wr-peg {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--rule-strong, #b9ac91);
    background: transparent;
    transition: background var(--dur-fast, 120ms) ease;
  }
  .wr-peg--filled {
    background: var(--pine, #2f5b3f);
    border-color: var(--pine, #2f5b3f);
  }
  .wr-val {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-mute, #6c6455);
    margin-left: 2px;
  }

  .workshop-rating--compact .wr-dim-label { display: none; }
  .workshop-rating--compact .wr-val { display: none; }
  .workshop-rating--compact .wr-peg { width: 8px; height: 8px; }

  @media (prefers-reduced-motion: reduce) {
    .wr-peg { transition: none; }
  }
</style>
