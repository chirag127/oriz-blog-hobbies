---
/**
 * PostCard — "tool-tag strip" style for The Bench (hobbies-blog.oriz.in).
 *
 * Each post is a horizontal tool-tag strip: a colour-coded left peg, the
 * title and category stamped on the strip, date and reading time as
 * engraved spec values on the right end. Reads like a label on a tool
 * drawer — not a magazine row, not a card, not a standard blog list row.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)
---

<article class="tool-strip" data-vertical={vert}>
  <a class="ts-link" href={href}>
    <span class="ts-peg" aria-hidden="true"></span>
    <span class="ts-body">
      <span class="ts-kicker mono">
        <span class="ts-desk">{verticalLabel(vert)}</span>
        <span class="ts-sep" aria-hidden="true">/</span>
        <span class="ts-cat">{category}</span>
      </span>
      <span class="ts-title">{title}</span>
      {description && <span class="ts-desc">{description}</span>}
    </span>
    <span class="ts-spec mono">
      <time class="ts-date" datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {readingTime && <span class="ts-rt">{readingTime}</span>}
    </span>
  </a>
  <a class="ts-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .tool-strip {
    --v: var(--v-personal);
    position: relative;
    display: flex;
    border-bottom: 1px solid var(--rule);
  }
  .tool-strip[data-vertical='dev'] { --v: var(--v-dev); }
  .tool-strip[data-vertical='finance'] { --v: var(--v-finance); }
  .tool-strip[data-vertical='culture'] { --v: var(--v-culture); }
  .tool-strip[data-vertical='health'] { --v: var(--v-health); }

  .ts-link {
    flex: 1;
    display: grid;
    grid-template-columns: 6px 1fr auto;
    align-items: center;
    gap: 0 0.9rem;
    padding: 0.85rem 0.5rem 0.85rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur-fast, 120ms) ease;
    border-radius: var(--radius-card, 4px);
  }
  .ts-link:hover { background: var(--bench-2); }

  /* left peg — a drilled circle in the tool-strip colour */
  .ts-peg {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--v);
    flex: 0 0 auto;
    margin-left: 2px;
    align-self: center;
    grid-row: 1 / 3;
  }

  .ts-body { display: grid; gap: 0.2rem; min-width: 0; }

  .ts-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .ts-desk { color: var(--v); font-weight: 600; }
  .ts-sep { color: var(--rule-strong); }
  .ts-cat { color: var(--ink-mute); }

  .ts-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ts-link:hover .ts-title { color: var(--v); }

  .ts-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-mute);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* right spec block */
  .ts-spec {
    display: grid;
    text-align: right;
    gap: 0.15rem;
    flex: 0 0 auto;
    align-self: center;
  }
  .ts-date {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    white-space: nowrap;
  }
  .ts-rt {
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    opacity: 0.75;
    white-space: nowrap;
  }

  /* keyboard-reachable category deep-link, visually hidden */
  .ts-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .ts-cat-link:focus-visible {
    width: auto; height: auto; clip: auto;
    top: 0.85rem; right: 0;
    padding: 0.125rem 0.5rem;
    background: var(--bench-2);
    border: 1px solid var(--v);
    color: var(--v);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    border-radius: var(--radius-card);
  }

  @media (max-width: 560px) {
    .ts-spec { display: none; }
    .ts-title { white-space: normal; }
    .ts-desc { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts-link { transition: none; }
  }
</style>
