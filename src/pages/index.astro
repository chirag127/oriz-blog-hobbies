---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — The Bench homepage. WORKBENCH SHELF archetype.
 *
 * Not a card grid, not a magazine front page. The page is a wall of
 * horizontal SHELVES: each content category is a rack rail with a stamped
 * end-plate label on the left, and its posts hung along the rail as tactile
 * tool-tags you scan left-to-right. Shelves stack vertically like a
 * pegboard/cabinet — you read the wall, then reach for the tool.
 *
 *   ┌ GEAR ─────────────────────────────────────────────────────────┐
 *   ┃ [ tool-tag ] [ tool-tag ] [ tool-tag ] [ tool-tag ] →          │
 *   └────────────────────────────────────────────────────────────────┘
 *   ┌ CRAFT ────────────────────────────────────────────────────────┐
 *   ┃ [ tool-tag ] [ tool-tag ] →                                     │
 *   └────────────────────────────────────────────────────────────────┘
 *
 * Hero = thesis (kept). "On the bench" = active series spine.
 * Verticals (Gear/Craft/Field/Care/Bench) each carry their marker colour.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsByCategory,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]

// Active series → "on the bench" spine in the hero.
const seriesAll = await getSeriesWithCounts()
let benchSeries:
  | { name: string; slug: string; total: number; published: number; current: number }
  | null = null
if (seriesAll[0]) {
  const { series, count } = seriesAll[0]
  const parts = await getPostsInSeries(series)
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  benchSeries = { name: series, slug: slugifyTag(series), total, published: count, current: count }
}

// One SHELF per category, most-stocked first. Each shelf carries up to 8
// posts as tool-tags; overflow drops to the shelf's "browse" end-cap.
const cats = await getCategoriesWithCounts()
type Shelf = {
  category: string
  slug: string
  vertical: ReturnType<typeof verticalFor>
  count: number
  posts: Awaited<ReturnType<typeof getPostsByCategory>>
}
const shelves: Shelf[] = []
for (const { category, count } of cats) {
  const posts = (await getPostsByCategory(category)).slice(0, 8)
  if (posts.length === 0) continue
  shelves.push({ category, slug: slugifyTag(category), vertical: verticalFor(category), count, posts })
}

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.name,
  url: `${SITE_CONFIG.origin}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: 'Chirag Singhal', url: 'https://me.oriz.in' },
}
---

<BaseLayout title="The Bench — Hobbies & Gear" description={SITE_CONFIG.description} jsonLd={jsonLd} hideSidebar>
  <div class="bench-wall">
    {/* Hero — thesis, stamped. */}
    <section class="hero" aria-label="Introduction">
      <p class="hero-stamp">
        <span class="spec-tab">Field guide</span>
        <span class="hero-est mono">Est. 2019 · {allPosts.length} entries on the rack</span>
      </p>
      <h1 class="hero-thesis">Gear you'll keep. Hobbies worth the bench space.</h1>
      <p class="hero-lede">Honest starter guides and gear notes — film photography, mechanical keyboards, woodworking, and the rest. What to buy first, what to skip, and why.</p>
      <hr class="hero-baseline" />
      {benchSeries && (
        <p class="hero-bench">
          <span class="spec-tab spec-tab--ghost">On the bench</span>
          <a class="hero-bench-name" href={`/series/${benchSeries.slug}/`}>{benchSeries.name}</a>
          <SeriesSpine total={benchSeries.total} published={benchSeries.published} current={benchSeries.current} size="md" />
        </p>
      )}
    </section>

    {lead && (
      <section class="pinned" data-vertical={leadVertical} aria-labelledby="pinned-title">
        <span class="pinned-plate mono">Pinned to the pegboard</span>
        <a class="pinned-link" href={`/blog/${lead.id}`}>
          <span class="pinned-kicker mono">
            <span class="pinned-tick" aria-hidden="true"></span>{verticalLabel(leadVertical)}
          </span>
          <h2 id="pinned-title" class="pinned-title">{lead.data.title}</h2>
          <p class="pinned-dek">{lead.data.description}</p>
          <span class="pinned-meta mono">
            <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toISOString().slice(0, 10)}</time>
            <span aria-hidden="true">·</span><span>{leadRt}</span>
          </span>
        </a>
      </section>
    )}

    {/* The shelves — one horizontal rack rail per category. */}
    {shelves.map((shelf) => (
      <section class="shelf" data-vertical={shelf.vertical} aria-labelledby={`shelf-${shelf.slug}`}>
        <div class="shelf-endplate">
          <h2 id={`shelf-${shelf.slug}`} class="shelf-label">
            <a href={`/categories/${shelf.slug}/`}>{shelf.category}</a>
          </h2>
          <span class="shelf-count mono">{shelf.count} on rack</span>
        </div>
        <ul class="shelf-rail" role="list">
          {shelf.posts.map((p) => (
            <li class="tool-tag">
              <a class="tool-link" href={`/blog/${p.id}`}>
                <span class="tool-hook" aria-hidden="true"></span>
                <time class="tool-date mono" datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <span class="tool-title">{p.data.title}</span>
                <span class="tool-rt mono">{p.data.readingTime ?? readingTimeFor(p)}</span>
              </a>
            </li>
          ))}
          <li class="tool-tag tool-tag--more">
            <a class="tool-more" href={`/categories/${shelf.slug}/`}>Full shelf →</a>
          </li>
        </ul>
      </section>
    ))}

    <p class="wall-foot mono">
      <a href="/archive/">Open the archive — all {allPosts.length} entries →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .bench-wall {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-bottom: 2rem;
  }

  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero { padding-block: clamp(2rem, 6vw, 3.75rem) 1.5rem; }
  .hero-stamp { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 0 0 1.5rem; }
  .hero-est { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); }
  .hero-thesis {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2.5rem, 7.5vw, 4.75rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 0.98;
    color: var(--ink); margin: 0; max-width: 16ch;
  }
  .hero-lede {
    font-family: var(--font-body); font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.5; color: var(--ink-mute); margin: 1.25rem 0 0; max-width: 54ch;
  }
  .hero-baseline { height: 3px; background: var(--copper); border: 0; margin: 1.5rem 0 0; width: 96px; }
  .hero-bench { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 1.5rem 0 0; }
  .hero-bench-name {
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule-strong);
  }
  .hero-bench-name:hover { color: var(--copper); border-bottom-color: var(--copper); }

  /* ── Pinned lead (pegboard) ────────────────────────────────────────── */
  .pinned {
    --v: var(--v-personal);
    position: relative;
    margin-top: 0.75rem;
    padding: 1.5rem clamp(1.1rem, 3vw, 2rem);
    background: var(--bench-2);
    border: 1px solid var(--rule-strong);
    border-left: 5px solid var(--v);
    border-radius: var(--radius-card);
  }
  .pinned[data-vertical='dev'] { --v: var(--v-dev); }
  .pinned[data-vertical='finance'] { --v: var(--v-finance); }
  .pinned[data-vertical='culture'] { --v: var(--v-culture); }
  .pinned[data-vertical='health'] { --v: var(--v-health); }
  .pinned-plate {
    position: absolute; top: -9px; left: clamp(1.1rem, 3vw, 2rem);
    background: var(--copper); color: var(--bench-2);
    font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 3px 8px; border-radius: 2px;
  }
  .pinned-link { display: grid; gap: 0.5rem; color: var(--ink); text-decoration: none; margin-top: 0.35rem; }
  .pinned-kicker {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--v); font-weight: 600;
  }
  .pinned-tick { width: 8px; height: 8px; background: var(--v); flex: 0 0 auto; }
  .pinned-title {
    font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; margin: 0; max-width: 22ch;
  }
  .pinned-link:hover .pinned-title { color: var(--accent); }
  .pinned-dek { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5; color: var(--ink-mute); margin: 0; max-width: 58ch; }
  .pinned-meta { display: inline-flex; gap: 0.5rem; font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute); }

  /* ── Shelves — horizontal rack rails ───────────────────────────────── */
  .shelf {
    --v: var(--v-personal);
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 3px solid var(--rule-strong);
  }
  .shelf[data-vertical='dev'] { --v: var(--v-dev); }
  .shelf[data-vertical='finance'] { --v: var(--v-finance); }
  .shelf[data-vertical='culture'] { --v: var(--v-culture); }
  .shelf[data-vertical='health'] { --v: var(--v-health); }

  .shelf-endplate {
    display: flex; align-items: baseline; gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .shelf-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
  }
  .shelf-label a {
    color: var(--v); text-decoration: none;
    border-bottom: 2px solid transparent; padding-bottom: 2px;
  }
  .shelf-label a:hover { border-bottom-color: var(--v); }
  .shelf-count { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }

  /* the rail: tool-tags in a horizontal scroll track, hung off the rail */
  .shelf-rail {
    list-style: none; margin: 0; padding: 0 0 0.5rem;
    display: flex; gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .tool-tag { scroll-snap-align: start; flex: 0 0 auto; }
  .tool-link {
    position: relative;
    display: grid; align-content: start; gap: 0.4rem;
    width: 15rem; min-height: 8.5rem;
    padding: 1.1rem 0.9rem 0.9rem;
    background: var(--bench-2);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--v);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    color: var(--ink); text-decoration: none;
    transition: transform var(--dur-fast) ease, border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  /* the hook: a drilled hole punched into the tool-tag's top edge */
  .tool-hook {
    position: absolute; top: -3px; left: 50%; transform: translateX(-50%);
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--bench); border: 1.5px solid var(--v);
  }
  .tool-link:hover {
    transform: translateY(2px);
    border-color: var(--v);
    box-shadow: 0 3px 0 0 color-mix(in oklab, var(--v) 30%, transparent);
  }
  .tool-date { font-size: 10.5px; letter-spacing: 0.06em; color: var(--ink-mute); }
  .tool-title {
    font-family: var(--font-display); font-size: 1.05rem; font-weight: 600;
    line-height: 1.25; letter-spacing: -0.01em; color: var(--ink);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .tool-link:hover .tool-title { color: var(--v); }
  .tool-rt { font-size: 10.5px; letter-spacing: 0.06em; color: var(--ink-mute); margin-top: auto; align-self: end; }

  .tool-tag--more { display: flex; align-items: stretch; }
  .tool-more {
    display: flex; align-items: center; justify-content: center;
    width: 8rem; padding: 1.1rem 0.9rem;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em;
    color: var(--ink-mute); text-decoration: none;
    border: 1px dashed var(--rule-strong); border-radius: var(--radius-card);
  }
  .tool-more:hover { color: var(--v); border-color: var(--v); }

  .wall-foot { margin: 2.5rem 0 0; font-size: 12px; letter-spacing: 0.06em; }
  .wall-foot a {
    color: var(--ink-mute); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rule);
  }
  .wall-foot a:hover { color: var(--copper); text-decoration-color: var(--copper); }

  @media (max-width: 640px) {
    .tool-link { width: 12.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-link { transition: none; }
    .tool-link:hover { transform: none; }
  }
</style>
